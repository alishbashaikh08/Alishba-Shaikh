# Find the second largest element in a list.

list1 = [10, 5, 8, 20, 15]

largest = list1[0]
second = list1[0]

for num in list1:
    if num > largest:
        second = largest
        largest = num
    elif num > second and num != largest:
        second = num

print("Second largest:", second)


