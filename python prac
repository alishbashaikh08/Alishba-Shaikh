# 3. Find the missing number in a list containing numbers from 1 to N
list1 = [1, 2, 3, 5, 6]

n = 6

total = 0
for i in range(1, n + 1):
    total = total + i

sum_list = 0
for num in list1:
    sum_list = sum_list + num

missing = total - sum_list

print("Missing number:", missing)

